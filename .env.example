# Copy to .env and fill in what you need. Every setting is optional.

# One-time token for /setup, required until the first administrator exists.
# If unset, the app generates one and prints it once to stdout
# (docker logs nis2check). A value set here is not printed.
# NIS2CHECK_SETUP_TOKEN=

# Public address of the app, used for single sign-on redirects (no trailing slash)
# NIS2_BASE_URL=https://nis2.example.com

# Set to 0.0.0.0 to expose the app on the network, only behind a reverse proxy with HTTPS.
# NIS2_BIND=127.0.0.1

# Set to true when the app is served over HTTPS (recommended in production)
# NIS2_SECURE_COOKIES=true

# Set to true when the app sits behind ONE reverse proxy (nginx, Traefik, a load balancer)
# that sets X-Forwarded-For/-Proto. Leave false if users connect to the app directly.
# NIS2_BEHIND_PROXY=false

# ---- Microsoft Entra ID single sign-on ----
# Register an app in Entra ID > App registrations, add a Web redirect URI:
#   <NIS2_BASE_URL>/sso/entra/callback
# Also add the "xms_edov" optional claim to the ID token (Token configuration);
# without it a first sign-in cannot be linked to an admin-created account.
# NIS2_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# NIS2_ENTRA_CLIENT_ID=
# NIS2_ENTRA_CLIENT_SECRET=

# ---- Google Workspace single sign-on ----
# Create an OAuth client (Web application) in Google Cloud Console, redirect URI:
#   <NIS2_BASE_URL>/sso/google/callback
# NIS2_GOOGLE_CLIENT_ID=
# NIS2_GOOGLE_CLIENT_SECRET=

# Only these email domains may sign in with SSO (comma-separated)
# NIS2_SSO_ALLOWED_DOMAINS=example.com

# Create accounts automatically on first SSO sign-in (otherwise an admin adds people first)
# NIS2_SSO_AUTO_PROVISION=false
# Role for automatically created accounts: viewer or assessor
# NIS2_SSO_DEFAULT_ROLE=viewer

# Turn off email and password sign-in once SSO works (keep one admin able to sign in!)
# NIS2_LOCAL_LOGIN=true

# Largest evidence file in MB
# NIS2_MAX_UPLOAD_MB=25

# Threat data: check automatically every N hours (updates still need admin approval)
# NIS2_THREAT_CHECK_HOURS=168
# For installs without internet access: a folder with vcdb.json.zip, enterprise-attack.json,
# kev.json and euvd.json copied in by hand
# NIS2_THREAT_SOURCE_DIR=/data/threat-sources
