<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ kicker }} - {{ assessment.entity.name or "Organisation" }}</title>
{% if font_css %}<link rel="stylesheet" href="{{ font_css }}">{% endif %}
<style>
  /* White, black and one navy accent; red, amber and green only for status. */
  @page {
    size: A4;
    margin: 20mm 18mm 20mm 18mm;
    @bottom-left { content: "{{ kicker }}, {{ _('Confidential') | lower }}"; font: 7.5pt "Public Sans", Arial, sans-serif; color: rgba(0,0,0,.55); }
    @bottom-right { content: counter(page) " / " counter(pages); font: 7.5pt "Public Sans", Arial, sans-serif; color: rgba(0,0,0,.55); }
  }
  :root {
    --navy: #16285a; --black: #000; --text-2: rgba(0,0,0,.62); --line: rgba(0,0,0,.16);
    --red: #b3261e; --amber: #e0a100; --green: #1e7f4f; --grey: rgba(0,0,0,.3);
    --serif: "Source Serif 4", Georgia, "Times New Roman", serif;
    --sans: "Public Sans", "Helvetica Neue", Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  html { background: #fff; }
  body { margin: 0; font: 400 9.5pt/1.5 var(--sans); color: var(--black); }
  .page { max-width: 210mm; margin: 0 auto 24px; padding: 20mm 18mm; }
  h1 { font: 400 28pt/1.1 var(--serif); letter-spacing: -.01em; margin: 2pt 0 6pt; }
  h2 { font: 600 14pt/1.3 var(--serif); margin: 26pt 0 9pt; page-break-after: avoid; break-after: avoid; }
  h3 { font: 600 11pt/1.3 var(--serif); margin: 16pt 0 6pt; page-break-after: avoid; break-after: avoid; }
  p { margin: 0 0 7pt; }
  .kicker { font-size: 10pt; color: var(--text-2); }
  .muted { color: var(--text-2); }
  .small { font-size: 8pt; }

  table { width: 100%; border-collapse: collapse; margin: 4pt 0 8pt; font-size: 8.5pt; }
  th, td { padding: 5pt 8pt 5pt 0; text-align: left; vertical-align: top; border-bottom: 0.5pt solid var(--line); }
  thead th { font-weight: 600; border-bottom: 1pt solid var(--black); }
  td:last-child, th:last-child { padding-right: 0; }
  tr { page-break-inside: avoid; break-inside: avoid; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  td.c, th.c { text-align: center; }
  .nowrap { white-space: nowrap; }
  td.ref { overflow-wrap: anywhere; }
  table.plan { table-layout: fixed; font-size: 8pt; }
  table.plan th, table.plan td { padding-right: 5pt; overflow-wrap: break-word; }
  table.plan td.long { hyphens: auto; }

  table.control { border-top: 1pt solid var(--black); }
  table.control th { width: 30%; font-weight: 600; }

  .rag { display: inline-block; width: 7pt; height: 7pt; border-radius: 50%; vertical-align: 0; margin-right: 5pt; }
  .rag-red { background: var(--red); } .rag-amber { background: var(--amber); }
  .rag-green { background: var(--green); } .rag-grey { background: var(--grey); }

  table.headline td { border: 0; vertical-align: bottom; padding: 4pt 0 10pt; }
  .figure { font: 400 64pt/0.9 var(--serif); color: var(--navy); letter-spacing: -.02em; white-space: nowrap; padding-right: 18pt !important; width: 1%; }
  .figure sup { font-size: 26pt; vertical-align: top; }
  .lede { font: 400 14pt/1.4 var(--serif); }
  table.facts { border-top: 0.5pt solid var(--line); }
  table.facts td { border: 0; width: 25%; padding-top: 8pt; color: var(--text-2); font-size: 8.5pt; }
  table.facts strong { display: block; font: 600 14pt/1.2 var(--serif); color: var(--black); }

  table.heat { width: auto; margin: 6pt 0 4pt; }
  table.heat th, table.heat td { text-align: center; padding: 6pt 12pt; min-width: 22mm; border: 0.5pt solid #fff; }
  table.heat thead th { border-bottom: 1pt solid var(--black); }
  table.heat tbody th { text-align: left; font-weight: 600; }
  table.heat td { font-weight: 600; font-size: 10pt; }
  .h-red { background: var(--red); color: #fff; }
  .h-amber, .h-yellow { background: var(--amber); }
  .h-green { background: var(--green); color: #fff; }
  td.h-empty { background: #fff; color: rgba(0,0,0,.35); border: 0.5pt solid var(--line); }

  .bar { width: 100%; height: 3pt; background: var(--line); margin-top: 4pt; }
  .bar span { display: block; height: 100%; }

  table.matrix th, table.matrix td { border: 0.5pt solid var(--line); padding: 7pt 9pt; }
  table.matrix thead th { border-bottom: 1pt solid var(--black); }
  table.matrix td { width: 40%; height: 24mm; }
  table.matrix tbody th { width: 20%; vertical-align: middle; font-weight: 600; }
  .q-title { font-weight: 600; display: block; margin-bottom: 3pt; }
  table.matrix td.q-quick { border: 1.25pt solid var(--navy); }
  .q-quick .q-title { color: var(--navy); }
  .note { border-left: 2pt solid var(--navy); padding: 2pt 0 2pt 10pt; margin: 8pt 0 10pt; font-size: 8.5pt; }
  footer.report-foot { margin-top: 18pt; padding-top: 8pt; border-top: 0.5pt solid var(--line); font-size: 8pt; color: var(--text-2); }
  .appendix, .new-page { page-break-before: always; break-before: page; }

  .toolbar { max-width: 210mm; margin: 0 auto; padding: 16px 18mm 0; text-align: right; }
  .toolbar button { font: 600 13px var(--sans); color: #000; background: #fff; border: 1px solid #000;
                    border-radius: 4px; padding: 6px 14px; margin-left: 6px; cursor: pointer; }
  .toolbar button:first-child { background: var(--navy); border-color: var(--navy); color: #fff; }

  @media print {
    .toolbar { display: none; }
    .page { padding: 0; margin: 0; max-width: none; }
    thead { display: table-header-group; }
  }
</style>
</head>
<body>

{% if not embedded %}
<div class="toolbar">
  <button type="button" onclick="window.print()">{{ _("Download PDF") }}</button>
  <button type="button" id="dl-csv">{{ _("Download gap register (CSV)") }}</button>
</div>
{% endif %}

<div class="page">

  <div class="kicker">{{ kicker }}</div>
  <h1>{{ assessment.entity.name or _("Unnamed organisation") }}</h1>
  <p class="muted" style="margin-bottom: 14pt;">{{ _("A self-assessment against {what}.", what=_(cover_line)) }}</p>
  {% if labels.assessed_against %}<p>{{ labels.assessed_against }}</p>{% endif %}
  {% if jurisdiction %}
    {% for notice in jurisdiction.notices %}
      <div class="note">{{ notice.label(lang) }}{% if notice.status %} ({{ notice.status }}){% endif %}</div>
    {% endfor %}
  {% endif %}
  {% if deadlines %}
    <ul>
    {% for item in deadlines %}
      <li>{% if item.date %}{{ local_date(item.date) }}: {% endif %}{{ item.label(lang) }}</li>
    {% endfor %}
    </ul>
  {% endif %}

  <table class="control">
    <tbody>
      <tr><th>{{ _("Organisation") }}</th><td>{{ assessment.entity.name or _("n/a") }}</td></tr>
      <tr><th>{{ _("Assessment date") }}</th><td>{{ report_date }}</td></tr>
      <tr><th>{{ _("Prepared by") }}</th><td>{{ assessment.assessor or _("n/a") }}</td></tr>
      <tr><th>{{ _("Framework") }}</th><td>{{ catalogue.source }} ({{ _("control catalogue v{v}", v=catalogue.version) }})</td></tr>
      <tr><th>{{ _("Control weighting") }}</th><td>{% if threat %}{{ _("Threat-informed") }} ({{ threat.version_label }}){% else %}{{ _("Regulatory baseline (static)") }}{% endif %}</td></tr>
      <tr><th>{{ _("Report generated") }}</th><td>{{ generated }}, nis2check {{ version }}</td></tr>
      <tr><th>{{ _("Classification") }}</th><td>{{ _("Confidential") }}</td></tr>
    </tbody>
  </table>

  <h2>{{ labels.h_summary }}</h2>

  {% set c = result.counts %}
  {% set critical_open = result.gaps | selectattr("question.priority", "equalto", "critical") | selectattr("status", "equalto", "gap") | list %}
  <table class="headline">
    <tbody><tr>
      <td class="figure">{{ "%.0f" | format(result.score_pct or 0) }}<sup>%</sup></td>
      <td class="lede">{{ _("of the {label} measures are in place.", label=measures_label) }} {{ _("{pct} can be shown with evidence today.", pct=result.verified_pct | pct) }}</td>
    </tr></tbody>
  </table>
  <table class="facts">
    <tbody><tr>
      <td><strong><span class="rag rag-{{ result.score_pct | rag }}"></span>{{ _(result.maturity) }}</strong>{{ _("Maturity") }}</td>
      <td><strong>{{ c.met }} / {{ c.met + c.partial + c.gap + c.unanswered }}</strong>{{ _("Controls fully met") }}</td>
      <td><strong>{{ critical_open | length }}</strong>{{ _("Critical controls not met") }}</td>
      <td><strong>{{ c.unanswered }}</strong>{{ _("Not assessed yet") }}</td>
      <td><strong>{{ result.evidence_issues | length }}</strong>{{ _("Answers without evidence") }}</td>
    </tr></tbody>
  </table>
  {% for p in summary %}<p>{{ p }}</p>{% endfor %}

  <h2>{{ labels.h_scope }}</h2>
  <table class="control">
    <tbody>
      <tr><th>{{ _("Indicative outcome") }}</th><td><strong>{{ _(result.applicability.label) }}</strong></td></tr>
      <tr><th>{{ _("Sector") }}</th><td>{{ sector_label or _("Not provided") }}{% if result.applicability.annex %} ({{ _("Annex {n}", n=result.applicability.annex) }}){% endif %}</td></tr>
      <tr><th>{{ _("Enterprise size") }}</th><td>{{ _("size|" ~ (result.applicability.size | capitalize)) }}{% if assessment.entity.employees %} ({{ _("employees: {n}", n=assessment.entity.employees) }}){% endif %}</td></tr>
    </tbody>
  </table>
  {% if result.applicability.notes %}
  <div class="note">{% for n in result.applicability.notes %}{{ n }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
  {% endif %}
  {% if show_lex %}
  <div class="note">{{ dora_scope_note }}</div>
  <div class="note">{{ lex_specialis }}</div>
  {% endif %}

  <h2>{{ labels.h_overview }}</h2>
  <h3>{{ labels.h_status }}</h3>
  <table>
    <thead><tr>
      <th class="c">RAG</th><th>{{ _("Ref") }}</th><th>{{ _("Requirement") }}</th><th class="nowrap">{{ labels.col_article }}</th>
      <th class="c">{{ _("Met") }}</th><th style="width: 22%;">{{ _("Coverage") }}</th><th class="num">{{ _("Score") }}</th><th class="num">{{ _("Evidenced") }}</th>
    </tr></thead>
    <tbody>
    {% for d in result.domains %}
      {% set dc = d.counts %}
      {% set st = domain_state(d) %}
      <tr>
        <td class="c"><span class="rag rag-{{ st.rag }}" style="margin:0"></span></td>
        <td><strong>{{ d.domain.id }}</strong></td>
        <td>{{ d.domain.title }}</td>
        <td class="nowrap">{{ cite(d.domain.article) }}</td>
        <td class="c nowrap">{{ dc.met }}/{{ dc.met + dc.partial + dc.gap + dc.unanswered }}</td>
        {% if st.not_assessed %}
        <td class="small muted" style="vertical-align: middle;">{{ _("Not assessed") }}</td>
        <td class="num muted">-</td>
        <td class="num muted">-</td>
        {% else %}
        <td style="vertical-align: middle;"><div class="bar two"><span class="rag-{{ st.rag }}" style="width: {{ st.proven }}%"></span><span class="claimed rag-{{ st.rag }}" style="width: {{ st.claimed }}%"></span></div></td>
        <td class="num"><strong>{{ d.score_pct | pct }}</strong></td>
        <td class="num">{{ d.verified_pct | pct }}</td>
        {% endif %}
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="small muted">{{ _("RAG: green 70% and above, amber 40 to 69%, red below 40%. Green needs evidence: a requirement answered as in place without evidence stays amber. Grey means not assessed yet. \"Evidenced\" counts only answers supported by existing evidence. In the bar, the solid part is backed by evidence and the light part is not yet.") }}</p>

  <h3>3.2 {{ _("Control heat map (priority x status)") }}</h3>
  <table class="heat">
    <thead><tr><th>{{ _("Priority") }}</th><th>{{ _("Not met") }}</th><th>{{ _("Not assessed") }}</th><th>{{ _("Partially met") }}</th><th>{{ _("Met") }}</th></tr></thead>
    <tbody>
    {% for row in heat %}
      <tr>
        <th>{{ _(row.label) }}</th>
        {% for cell in row.cells %}
        <td class="h-{{ cell.colour }}{% if cell.count == 0 %} h-empty{% endif %}">{{ cell.count }}</td>
        {% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="small muted">{{ _("Number of controls in each cell. Colour shows severity: control priority weighted by missing coverage.") }}</p>

  <h3>3.3 {{ _("Impact vs effort") }}</h3>
  {% if result.gaps %}
  <table class="matrix">
    <thead><tr><th></th><th>{{ _("Low effort") }}</th><th>{{ _("Medium or high effort") }}</th></tr></thead>
    <tbody>
      {% for impact, cells in (("High impact", ("Quick win", "Major project")), ("Lower impact", ("Fill-in", "Schedule later"))) %}
      <tr>
        <th>{{ _(impact) }}</th>
        {% for name in cells %}
        {% set cls = {"Quick win": "q-quick", "Major project": "q-major", "Fill-in": "q-fill", "Schedule later": "q-later"}[name] %}
        <td class="{{ cls }}"><span class="q-title">{{ _({"Quick win": "Quick wins", "Major project": "Major projects", "Fill-in": "Fill-ins", "Schedule later": "Schedule later"}[name]) }} ({{ matrix[name] | length }})</span>
          <span class="small">{% for f in matrix[name] %}{{ f.question.id }}{% if not loop.last %}, {% endif %}{% endfor %}</span></td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="small muted">{{ _("Impact is the risk reduction from closing the item (control weight x missing coverage); high means at or above the median of open items. Effort is an estimate for an SME. Quick wins are the natural first wave of remediation.") }}</p>
  {% else %}
  <p>{{ _("No open items.") }}</p>
  {% endif %}

  <h2>{{ labels.h_plan }}</h2>
  {% if top_gaps %}
  <p>{{ _("Highest-priority open items: {shown} of {total}.", shown=top_gaps | length, total=result.gaps | length) }}{% if result.gaps | length > top_gaps | length %} {{ _("The full gap register is available as a CSV download.") }}{% endif %} {% if result.rank_by == "value" %}{{ _("Items are ranked by risk reduction per unit of effort.") }}{% else %}{{ _("Items are ranked by risk reduction (control weight x missing coverage).") }}{% endif %}{% if threat %} {{ _("Weights are threat-informed.") }}{% endif %} {{ _("Owners and target dates are left for the organisation to assign.") }}</p>
  <table class="plan">
    <colgroup>
      <col style="width: 3%;"><col style="width: 14%;"><col style="width: 22%;"><col style="width: 10%;"><col style="width: 9%;">
      <col style="width: 8%;"><col style="width: 20%;"><col style="width: 7%;"><col style="width: 7%;">
    </colgroup>
    <thead><tr>
      <th>#</th><th>{{ _("Ref") }}</th><th>{{ _("Finding") }}</th><th>{{ _("Priority") }}</th><th>{{ _("Status") }}</th><th>{{ _("Effort") }}</th>
      <th>{{ _("Recommended action") }}</th><th>{{ _("Owner") }}</th><th>{{ _("Target") }}</th>
    </tr></thead>
    <tbody>
    {% for f in top_gaps %}
      <tr>
        <td>{{ loop.index }}</td>
        <td class="ref"><strong class="nowrap">{{ f.question.id }}</strong><br><span class="small muted">{{ cite(f.question.article or (result.domains | selectattr("domain.id", "equalto", f.question.domain_id) | map(attribute="domain.article") | first), f.question) }}</span></td>
        <td class="long">{{ f.question | qtext }}</td>
        <td class="nowrap"><span class="rag rag-{{ finding_rag(f) }}"></span>{{ _(priority_label[f.question.priority]) }}</td>
        <td>{{ _(status_label[f.status]) }}</td>
        <td>{{ _(f.question.effort | capitalize) }}</td>
        <td class="long">{{ f.question.remediation }}</td>
        <td></td><td></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>{{ _("No open items. All applicable controls are reported as met.") }}</p>
  {% endif %}

  <h2>{{ labels.h_evidence }}</h2>
  {% if result.evidence_issues %}
  <p>{{ _("Controls reported as met or partially met without usable evidence: {n}. Until evidence is provided, these controls are excluded from the evidence-backed score.", n=result.evidence_issues | length) }}</p>
  <table>
    <thead><tr><th>{{ _("Ref") }}</th><th>{{ _("Reported status") }}</th><th>{{ _("Expected evidence") }}</th><th>{{ _("Issue") }}</th></tr></thead>
    <tbody>
    {% for f in result.evidence_issues %}
      <tr>
        <td class="nowrap"><strong>{{ f.question.id }}</strong></td>
        <td class="nowrap">{{ _(status_label[f.status]) }}</td>
        <td>{{ f.question.evidence_hint }}</td>
        <td>{% for i in f.evidence_issues %}{{ _(i) }}{% if not loop.last %}; {% endif %}{% endfor %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>{{ _("All controls reported as met or partially met are supported by existing evidence.") }}</p>
  {% endif %}

  <div class="appendix">
    <h2>{{ _("Appendix A. Detailed control results") }}</h2>
    {% for d in result.domains %}
    <h3>{{ d.domain.id }}. {{ d.domain.title }} ({{ cite(d.domain.article) }}): {{ d.score_pct | pct }}</h3>
    {% if jurisdiction and jurisdiction.article(d.domain.article) and jurisdiction.article(d.domain.article).note %}
    <p class="small">{{ jurisdiction.article(d.domain.article).note }}</p>
    {% endif %}
    <table class="plan">
      <thead><tr><th style="width: 21%;">{{ _("Ref") }}</th><th style="width: 28%;">{{ _("Control") }}</th><th style="width: 9%;">{{ _("Priority") }}</th><th style="width: 12%;">{{ _("Status") }}</th><th style="width: 17%;">{{ _("Evidence") }}</th><th style="width: 13%;">{{ _("Notes") }}</th></tr></thead>
      <tbody>
      {% for f in d.findings %}
        <tr>
          <td class="ref"><span class="nowrap">{{ f.question.id }}</span><br><span class="small muted">{{ cite(f.question.article or d.domain.article, f.question) }}</span></td>
          <td class="long">{{ f.question | qtext }}</td>
          <td class="nowrap">{{ _(priority_label[f.question.priority]) }}</td>
          <td class="nowrap"><span class="rag rag-{{ finding_rag(f) }}"></span>{{ _(status_label[f.status]) }}</td>
          <td class="small">{% for e in f.response.evidence %}{{ e }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% if f.evidence_issues %}<br><span style="color: var(--red);">{% for i in f.evidence_issues %}{{ _(i) }}{% if not loop.last %}; {% endif %}{% endfor %}</span>{% endif %}</td>
          <td class="small">{{ f.response.notes }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endfor %}

    <h2>{{ _("Appendix B. Methodology") }}</h2>
    <p>{{ _("Each requirement is broken down into practical controls, and each control is given a regulatory priority: critical (weight 3), high (weight 2) or medium (weight 1).") }} {% if threat %}{{ _("This baseline is then raised by up to 50% for controls that counter threats common in recent incident data: the uplift is proportional to the combined prevalence of the threat patterns the control counters, relative to the most exposed control. Threat data can raise a weight but never lower it below the regulatory baseline, because every control is a legal requirement. Sources and links are listed in Appendix C.") }} {% endif %}{{ _("Answers are scored as met = 1, partially met = 0.5, not met = 0 and not assessed = 0. Controls marked not applicable are excluded.") }}</p>
    <p>{{ _("The overall and per-requirement scores are weighted averages of the applicable controls. The evidence-backed score applies the same calculation but counts a control only when every evidence item recorded for it exists. Open items are ranked by control weight multiplied by missing coverage, so an unaddressed critical control ranks above a partially met medium one.") }}</p>
    <p>{{ _("Effort is an estimate (low, medium, high) of the work needed for an SME to implement the control. Risk reduction per unit of effort divides the risk reduction by 1, 2 or 3 respectively and drives the impact vs effort matrix.") }}</p>
    <p>{{ _("Maturity bands: strong (90% and above), substantial (70 to 89%), partial (40 to 69%), low (below 40%).") }}</p>
    <p class="small muted">{{ _("This report is a self-assessment and does not constitute a certification, audit opinion or legal advice. National transposition laws, implementing acts and guidance from the competent authority may impose additional or more specific requirements.") }}</p>

    {% if threat %}
    <h2 class="new-page">{{ _("Appendix C. Threat data and weighting") }}</h2>
    <p>{{ _("Control weights in this report use {label}.", label=threat.version_label) }} {{ _("Prevalence is the share of confirmed or suspected incident events in the VERIS Community Database (VCDB) matching each threat pattern, with mass campaigns counted once. Links between controls and threat patterns come from MITRE ATT&CK mitigation relationships, plus catalogue links for patterns ATT&CK does not cover (human error, insider misuse, physical loss, supplier involvement).") }}</p>

    <h3>C.1 {{ _("Sources") }}</h3>
    <table>
      <thead><tr><th>{{ _("Source") }}</th><th>{{ _("Version") }}</th><th>{{ _("Retrieved") }}</th><th>{{ _("Status") }}</th></tr></thead>
      <tbody>
      {% for key, label in (("vcdb", "VERIS Community Database (VCDB)"), ("mitre_attack", "MITRE ATT&CK Enterprise"), ("cisa_kev", "CISA Known Exploited Vulnerabilities"), ("enisa_euvd", "ENISA EU Vulnerability Database")) %}
        {% set s = threat.sources.get(key, {}) %}
        <tr>
          <td>{{ label }}</td>
          <td class="small">{% if key == "vcdb" %}{{ threat.vcdb.window.from_year }}-{{ threat.vcdb.window.to_year }}, {{ _("events: {n}", n=threat.vcdb.sample_size) }}{% elif s.version %}{{ s.version }}{% else %}{{ _("n/a") }}{% endif %}</td>
          <td class="small nowrap">{{ (s.retrieved or "n/a")[:10] }}</td>
          <td class="nowrap">{% if s.status == "ok" %}<span class="rag rag-green"></span>{{ _("Used") }}{% else %}<span class="rag rag-amber"></span>{{ _("Unavailable") }}{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="small muted">{{ _("Exploitation trend factor: {f}.", f=threat.trend.factor) }}{% if threat.trend.factor == 1.0 %} {{ _("Neutral: no trend data available or no change.") }}{% endif %} {{ _("Applied to the vulnerability exploitation pattern only, within the range 0.8 to 1.25.") }}</p>

    <h3>C.2 {{ _("Threat patterns") }}</h3>
    <table>
      <thead><tr><th>{{ _("Pattern") }}</th><th class="num">{{ _("Events") }}</th><th class="num">{{ _("Prevalence") }}</th><th>{{ _("ATT&CK mitigations linked") }}</th></tr></thead>
      <tbody>
      {% for pid, p in threat.patterns.items() | sort(attribute="1.adjusted_prevalence", reverse=True) %}
        <tr>
          <td>{{ p.name }}</td>
          <td class="num">{{ p.incidents }}</td>
          <td class="num">{{ "%.1f" | format(p.adjusted_prevalence * 100) }}%</td>
          <td class="small">{{ p.attack_mitigations | join(", ") or _("Catalogue links only") }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% if threat.vcdb.campaigns_collapsed %}
    <p class="small muted">{{ _("Campaigns counted once:") }} {% for c in threat.vcdb.campaigns_collapsed[:3] %}{{ c.label }} ({{ _("records: {n}", n=c.records) }}){% if not loop.last %}; {% endif %}{% endfor %}.</p>
    {% endif %}

    <h3>C.3 {{ _("Controls with a threat-informed uplift") }}</h3>
    <table>
      <thead><tr><th>{{ _("Ref") }}</th><th class="num">{{ _("Baseline") }}</th><th class="num">{{ _("Weight") }}</th><th>{{ _("Counters") }}</th></tr></thead>
      <tbody>
      {% for f in uplifted %}
        <tr>
          <td class="nowrap"><strong>{{ f.question.id }}</strong></td>
          <td class="num">{{ f.weight_info.base }}</td>
          <td class="num">{{ "%.2f" | format(f.weight) }}</td>
          <td class="small">{% for pid in f.weight_info.patterns %}{{ threat.patterns[pid].name }} <span class="muted">({{ f.weight_info.via[pid] }})</span>{% if not loop.last %}; {% endif %}{% endfor %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="small muted">{{ _("Caveats: VCDB contains publicly reported incidents, mostly from the United States and weighted toward breaches that reach the news; it is not the full Verizon DBIR dataset. CISA KEV is US-centric; ENISA EUVD gives an EU view but is newer.") }}</p>
    {% endif %}
  </div>

  <footer class="report-foot">{{ not_legal_advice }}</footer>

</div>

{% if not embedded %}
<script id="gap-register" type="application/json">{{ csv_data | tojson }}</script>
<script>
  document.getElementById("dl-csv").addEventListener("click", function () {
    var csv = JSON.parse(document.getElementById("gap-register").textContent);
    var blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = {{ (file_slug ~ ".csv") | tojson }};
    document.body.appendChild(a);
    a.click();
    setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 0);
  });
</script>
{% endif %}
</body>
</html>
